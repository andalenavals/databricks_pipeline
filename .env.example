# ==============================================================================
# DATABRICKS LOCAL CONNECTION & AUTHENTICATION
# Used by: Databricks SDK, CLI, databricks-connect, local Python scripts
# ==============================================================================
#DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
#DATABRICKS_TOKEN= your_toke_here

# Optional: Profile name from ~/.databrickscfg if using OAuth/M2M instead of a Personal Access Token (PAT)
# DATABRICKS_CONFIG_PROFILE=DEV

# ==============================================================================
# COMPUTING & ENVIRONMENT CONFIGURATION
# Parameterize resource IDs and target environments locally
# ==============================================================================
#DATABRICKS_WAREHOUSE_ID=a1b2c3d4e5f6g7h8
#DATABRICKS_CLUSTER_ID=0123-456789-abcde123

# Target Unity Catalog & Schema for local PySpark/SDK execution
#TARGET_CATALOG=dev_catalog
#TARGET_SCHEMA=sandbox

# ==============================================================================
# APPLICATION SECRETS (Local Testing Only)
# ==============================================================================
#DATABASE_URL=postgresql://user:password@localhost:5432/mydb
#OPENAI_API_KEY=sk-proj-123456...